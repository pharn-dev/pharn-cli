{
  "name": "pharn",
  "version": "0.3.0",
  "description": "Audit-grade AI development methodology for Claude Code — spec, plan, grill, build, verify, ship.",
  "keywords": [
    "claude-code",
    "ai",
    "methodology",
    "code-review",
    "audit",
    "agents"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pharn-dev/pharn-cli.git"
  },
  "bugs": {
    "url": "https://github.com/pharn-dev/pharn-cli/issues"
  },
  "homepage": "https://github.com/pharn-dev/pharn-cli#readme",
  "type": "module",
  "bin": {
    "pharn": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc --noEmit && node scripts/build.mjs",
    "build:install-local": "npm run build && node scripts/install-local.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.config.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.config.ts\"",
    "lint:md": "markdownlint-cli2 \"docs/**/*.md\" \"*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "degit": "^3.6.1",
    "minimist": "^1.2.8",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.7.0",
    "markdownlint-cli2": "^0.23.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
